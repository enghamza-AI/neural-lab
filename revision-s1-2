RANDOM_STATE = 42

print("-" * 20)
print("Gradient descent by hand")
print("-"*20)

hours_studied = np.array([1,2,3,4,5], dtype=float)
exam_score = np.array([52, 58, 63, 70, 75], dtype=float)

w = 0.0
b = 0.0
learning_rate = 0.05
epochs = 1000
n = len(hours_studied)

loss_history = []

for epoch in range(epochs):
    y_pred = w * hours_studied + b
    error = y_pred - exam_score

    loss = np.mean(error ** 2)
    loss_history.append(loss)

    grad_w = (2 / n) * np.sum(error * hours_studied)
    grad_b = (2 / n) * np.sum(error)

    w = w - learning_rate * grad_w
    b = b - learning_rate * grad_b

print(f"Learned slope (w):  {w:.3f}")
print(f"Learned intercept (b): {b:.3f}")
print(f"Final loss (MSE):    {loss_history[-1]:.4f}")
print(f"Loss after epoch 1: {loss_history[0]:.4f}")
print(f"Loss after 10 epochs:   {loss_history[9]:.4f}")
print(f"loss after 900 epochs: {loss_history[899]:.4f}")

